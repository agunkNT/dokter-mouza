@model DokterAbdurrahman.Models.Pemeriksaan

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>@ViewData["TitleHeader"]</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Tanggal)
        </dt>
        <dd class = "col-sm-10">
            @Model.Tanggal.ToString("dd MMM yyyy")
        </dd>
        <dt class = "col-sm-2">
            Patient
        </dt>
        <dd class = "col-sm-10">
            @Model.Pasien?.Nama
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Keterangan)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Keterangan)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        @if(Model.JenisPemeriksaan == "KONSULTASI_PRE") {
                <a asp-action="KonsultasiPre" class="btn btn-secondary">Back to List</a>
        } else {
                <a asp-action="ControlPost" class="btn btn-secondary">Back to List</a>
        }
    </form>
</div>
