@model IEnumerable<DokterAbdurrahman.Models.Pemeriksaan>

@{
    string type = ViewData["Type"] as string ?? "KONSULTASI_PRE";
}

<div class="row mb-3">
    <div class="col-md-12 d-flex justify-content-between align-items-center">
        <h2>@ViewData["Title"]</h2>
        <a asp-action="Create" asp-route-type="@type" class="btn btn-primary">Create New</a>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-12">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form method="get" asp-action="@(type == "KONSULTASI_PRE" ? "KonsultasiPre" : "ControlPost")" class="row align-items-end g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-muted text-uppercase mb-1">Tgl Awal</label>
                        <input type="date" name="startDate" class="form-control" value="@ViewData["StartDate"]" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-muted text-uppercase mb-1">Tgl Akhir</label>
                        <input type="date" name="endDate" class="form-control" value="@ViewData["EndDate"]" />
                    </div>
                    <div class="col-md-3">
                         <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-filter me-1"></i> Filter
                            </button>
                         </div>
                    </div>
                    <div class="col-md-3 text-end">
                         <div class="d-grid">
                            <a asp-action="@(type == "KONSULTASI_PRE" ? "KonsultasiPre" : "ControlPost")" class="btn btn-outline-secondary">
                                <i class="fas fa-redo me-1"></i> Reset
                            </a>
                         </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover" id="table-pemeriksaan">
        <thead>
            <tr>
                <th>Date</th>
                <th>Patient</th>
                <th>Tindakan</th>
                <th>Keterangan</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Tanggal.ToString("dd MMM yyyy")</td>
                    <td>@item.Pasien?.Nama (@item.Pasien?.NoRM)</td>
                    <td>@item.Tindakan?.Nama</td>
                    <td>@item.Keterangan</td>
                    <td>
                        <div class="d-flex">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info me-2 text-white">Detail</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-2">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <script>
        $(document).ready(function() {
            $('#table-pemeriksaan').DataTable({
                "order": [[ 0, "desc" ]],
                "scrollX": true,
                "autoWidth": false
            });
        });
    </script>
}
