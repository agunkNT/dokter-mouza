@model DokterAbdurrahman.Models.Pemeriksaan

@{
    ViewData["Title"] = (Model.Id == 0 ? "Create" : "Edit") + " " + ViewData["TitleHeader"];
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="JenisPemeriksaan" />

            <div class="form-group mb-3">
                <label asp-for="Tanggal" class="control-label"></label>
                <input asp-for="Tanggal" class="form-control" type="date" />
                <span asp-validation-for="Tanggal" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PasienId" class="control-label">Patient</label>
                <select asp-for="PasienId" class="form-control" asp-items="ViewBag.PasienId"></select>
                <span asp-validation-for="PasienId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                 <label asp-for="TindakanId" class="control-label">Rencana Tindakan / Tindakan</label>
                 <select asp-for="TindakanId" class="form-control" asp-items="ViewBag.TindakanId">
                     <option value="">-- Select Tindakan --</option>
                 </select>
                 <span asp-validation-for="TindakanId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Keterangan" class="control-label"></label>
                <textarea asp-for="Keterangan" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Keterangan" class="text-danger"></span>
            </div>

            <div class="card mt-4 mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Upload Media</h5>
                </div>
                <div class="card-body">
                    <div class="form-group mb-3">
                        <label class="form-label">Upload Photos</label>
                        <input type="file" name="fotos" class="form-control" multiple accept="image/*" />
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label">Upload Videos</label>
                        <input type="file" name="videos" class="form-control" multiple accept="video/*" />
                    </div>
                </div>
            </div>

            @if(Model.Medias != null && Model.Medias.Any())
            {
                <div class="mb-4">
                    <h5 class="text-uppercase text-secondary small mb-3">Existing Media</h5>
                    <div class="row g-3">
                        @foreach(var media in Model.Medias)
                        {
                            <div class="col-md-3 col-6">
                                <div class="card h-100">
                                    @if(media.Type == DokterAbdurrahman.Models.MediaType.Foto)
                                    {
                                        <div class="ratio ratio-4x3 bg-light d-flex align-items-center justify-content-center overflow-hidden">
                                             <img src="https://lh3.googleusercontent.com/d/@media.FileId" class="card-img-top" style="object-fit: cover; height: 100%;" alt="Foto">
                                        </div>
                                        <div class="card-body p-2 text-center">
                                            <a href="https://drive.google.com/file/d/@media.FileId/view" target="_blank" class="btn btn-sm btn-outline-primary w-100">View</a>
                                        </div>
                                    }
                                    else
                                    {
                                         <div class="ratio ratio-4x3 bg-dark d-flex align-items-center justify-content-center">
                                             <i class="fa fa-play-circle text-white display-4"></i>
                                         </div>
                                         <div class="card-body p-2 text-center">
                                            <a href="https://drive.google.com/file/d/@media.FileId/view" target="_blank" class="btn btn-sm btn-outline-danger w-100">Watch</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="form-group mt-4">
                <input type="submit" value="Save" class="btn btn-primary" />
                @if(Model.JenisPemeriksaan == "KONSULTASI_PRE") {
                     <a asp-action="KonsultasiPre" class="btn btn-secondary">Back to List</a>
                } else {
                     <a asp-action="ControlPost" class="btn btn-secondary">Back to List</a>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <!-- Select2 or similar could be added here for better Patient searching -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            $('select').select2({
                theme: 'bootstrap-5'
            });
        });
    </script>
}
