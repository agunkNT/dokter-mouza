@model DokterAbdurrahman.Models.LaporanOperasi

@{
    ViewData["Title"] = "Details Laporan Operasi";
}

<div class="d-print-none mb-3">
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    <button onclick="window.print()" class="btn btn-primary">Print / Save as PDF</button>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
</div>

<div class="card shadow-sm" id="printArea">
    <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
        <div class="row">
            <div class="col-8">
                <h2 class="text-primary mb-0">Laporan Operasi</h2>
                <p class="text-muted small">Code: @Model.Code | Tanggal: @Model.Tanggal.ToString("dd MMMM yyyy")</p>
            </div>
            <div class="col-4 text-end">
                <h4 class="mb-0">@Model.RumahSakit?.Nama</h4>
                <p class="text-muted small">@Model.RumahSakit?.Alamat</p>
            </div>
        </div>
        <hr />
    </div>
    
    <div class="card-body">
        <div class="row mb-4">
            <div class="col-md-6">
                <h5 class="text-uppercase text-secondary small">Data Pasien</h5>
                <table class="table table-borderless table-sm">
                    <tr><td width="150">Nama Pasien</td><td>: <strong>@Model.Pasien?.Nama</strong></td></tr>
                    <tr><td>No RM (Sistem)</td><td>: @Model.Pasien?.NoRM</td></tr>
                    <tr><td>No RM (RS)</td><td>: @(string.IsNullOrEmpty(Model.NoRM) ? "-" : Model.NoRM)</td></tr>
                    <tr><td>Jenis Kelamin</td><td>: @Model.Pasien?.JenisKelamin</td></tr>
                    <tr><td>Umur</td><td>: @Model.Umur</td></tr>
                </table>
            </div>
             <div class="col-md-6">
                <h5 class="text-uppercase text-secondary small">Tim Operasi</h5>
                <table class="table table-borderless table-sm">
                    <tr><td width="120">Operator</td><td>: <strong>@Model.Operator?.Nama</strong></td></tr>
                    <tr><td>DPJP/Konsulen</td><td>: @Model.DPJP?.Nama</td></tr>

                </table>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-12">
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Diagnosa</th>
                            <th>Tindakan</th>
                            <th>Jenis Tindakan</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                @if (Model.LaporanOperasiDiagnosas != null && Model.LaporanOperasiDiagnosas.Any())
                                {
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var d in Model.LaporanOperasiDiagnosas)
                                        {
                                            <li>- @d.Diagnosa?.Nama (@d.Diagnosa?.KodeICD)</li>
                                        }
                                    </ul>
                                }
                            </td>
                            <td>@Model.Tindakan?.Nama</td>
                            <td>
                                @if(Model.JenisTindakans != null)
                                {
                                    <ul class="list-unstyled mb-0">
                                        @foreach(var jt in Model.JenisTindakans)
                                        {
                                            <li>- @jt.JenisTindakan?.Nama</li>
                                        }
                                    </ul>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        
        <div class="row mb-4">
            <div class="col-12">
                <h5 class="text-uppercase text-secondary small">Indikator Medis</h5>
                <div class="d-flex gap-4">
                   <div class="form-check">
                       <input class="form-check-input" type="checkbox" checked="@Model.Hidrosefalus" disabled>
                       <label>Hidrosefalus</label>
                   </div>
                   <div class="form-check">
                       <input class="form-check-input" type="checkbox" checked="@Model.ETV" disabled>
                       <label>ETV</label>
                   </div>
                   <div class="form-check">
                       <input class="form-check-input" type="checkbox" checked="@Model.Shunt" disabled>
                       <label>Shunt</label>
                   </div>
                   <div class="form-check">
                       <input class="form-check-input" type="checkbox" checked="@Model.ETVGagalShunt" disabled>
                       <label>ETV Gagal Shunt</label>
                   </div>
                   <div class="form-check">
                       <input class="form-check-input" type="checkbox" checked="@Model.ETVGagalShunt2" disabled>
                       <label>ETV Gagal Shunt 2</label>
                   </div>
                </div>
            </div>
        <div class="row mb-4">
            <div class="col-12">
                <h5 class="text-uppercase text-secondary small">Glasgow Outcome Scale (GOS)</h5>
                <div class="p-3 border rounded bg-light shadow-sm">
                    @if(Model.GOS.HasValue)
                    {
                        <div class="d-flex align-items-center">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3 fs-5" style="width: 40px; height: 40px; font-weight: bold;">
                                @Model.GOS.Value
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">
                                    @if(Model.GOS == 1) { <text>Dead</text> }
                                    else if(Model.GOS == 2) { <text>Vegetative State</text> }
                                    else if(Model.GOS == 3) { <text>Severe Disability</text> }
                                    else if(Model.GOS == 4) { <text>Moderate Disability</text> }
                                    else if(Model.GOS == 5) { <text>Good Recovery</text> }
                                </h6>
                                <p class="mb-0 text-muted">
                                    @if(Model.GOS == 1) { <text>Death due to the injury.</text> }
                                    else if(Model.GOS == 2) { <text>Minimal responsiveness, inability to interact.</text> }
                                    else if(Model.GOS == 3) { <text>Conscious but dependent on others for daily support.</text> }
                                    else if(Model.GOS == 4) { <text>Independent at home but disabled in community/work.</text> }
                                    else if(Model.GOS == 5) { <text>Resumption of normal life, despite minor deficits.</text> }
                                </p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">GOS not recorded for this operation.</span>
                    }
                </div>
            </div>
        </div>

        @if(!string.IsNullOrEmpty(Model.Keterangan))
        {
            <div class="row mb-4">
                <div class="col-12">
                    <h5 class="text-uppercase text-secondary small">Keterangan / Catatan</h5>
                    <div class="p-3 bg-light rounded border">
                        @Model.Keterangan
                    </div>
                </div>
            </div>
        }

        @if(Model.Medias != null && Model.Medias.Any())
        {
            <div class="d-print-none mt-4">
                <h5 class="text-uppercase text-secondary small mb-3">Dokumentasi Operasi</h5>
                <div class="row g-3">
                    @foreach(var media in Model.Medias)
                    {
                        var mediaUrl = $"/LaporanOperasi/Media/{media.Id}";
                        <div class="col-md-3 col-6">
                            <div class="card h-100 shadow-sm">
                                @if(media.Type == DokterAbdurrahman.Models.MediaType.Foto)
                                {
                                    <a href="@mediaUrl" target="_blank">
                                        <div class="ratio ratio-4x3 bg-light overflow-hidden">
                                            <img src="@mediaUrl" class="card-img-top"
                                                 style="object-fit: cover; height: 100%;"
                                                 alt="Foto Operasi"
                                                 onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'d-flex align-items-center justify-content-center h-100 text-muted\'><i class=\'bi bi-image fs-1\'></i></div>';">
                                        </div>
                                    </a>
                                    <div class="card-body p-2 text-center">
                                        <a href="@mediaUrl" target="_blank" class="btn btn-sm btn-outline-primary w-100">
                                            <i class="bi bi-zoom-in me-1"></i>Lihat Foto
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <div class="ratio ratio-4x3 bg-dark d-flex align-items-center justify-content-center">
                                        <i class="bi bi-play-circle text-white display-4"></i>
                                    </div>
                                    <div class="card-body p-2 text-center">
                                        <a href="@mediaUrl" target="_blank" class="btn btn-sm btn-outline-danger w-100">
                                            <i class="bi bi-play-fill me-1"></i>Tonton Video
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<style media="print">
    body { background-color: white !important; }
    .d-print-none { display: none !important; }
    .card { border: none !important; box-shadow: none !important; }
    .card-header { background-color: white !important; }
</style>
