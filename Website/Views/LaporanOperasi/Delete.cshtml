@model DokterAbdurrahman.Models.LaporanOperasi

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete Laporan Operasi</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Tanggal)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Tanggal)
        </dd>
        <dt class = "col-sm-2">
            Pasien
        </dt>
        <dd class = "col-sm-10">
            @Model.Pasien?.Nama
            @* Or @Model.Pasien?.Nama to be safe, but DisplayFor handles nulls usually *@
        </dd>
         <dt class = "col-sm-2">
            Diagnosa
        </dt>
        <dd class = "col-sm-10">
            @if(Model.LaporanOperasiDiagnosas != null)
            {
               foreach(var d in Model.LaporanOperasiDiagnosas)
               {
                   <span>@d.Diagnosa?.Nama</span><br/>
               }
            }
        </dd>
         <dt class = "col-sm-2">
            Tindakan
        </dt>
        <dd class = "col-sm-10">
            @Model.Tindakan?.Nama
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
