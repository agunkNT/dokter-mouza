@model DokterAbdurrahman.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<!-- Period Filter Row -->
<div class="row mb-3">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body py-2 px-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa fa-filter text-primary"></i>
                    <strong class="text-secondary">Filter Periode Tanggal:</strong>
                </div>
                <div class="btn-group flex-wrap" role="group">
                    <a href="?period=all" class="btn btn-sm @(ViewBag.SelectedPeriod == "all" || string.IsNullOrEmpty(ViewBag.SelectedPeriod) ? "btn-primary" : "btn-outline-primary")">Semua Periode</a>
                    <a href="?period=today" class="btn btn-sm @(ViewBag.SelectedPeriod == "today" ? "btn-primary" : "btn-outline-primary")">Hari Ini</a>
                    <a href="?period=month" class="btn btn-sm @(ViewBag.SelectedPeriod == "month" ? "btn-primary" : "btn-outline-primary")">Sebulan Lalu</a>
                    <a href="?period=year" class="btn btn-sm @(ViewBag.SelectedPeriod == "year" ? "btn-primary" : "btn-outline-primary")">1 Tahun Terakhir</a>
                </div>
                <form method="get" action="" class="d-flex align-items-center gap-1">
                    <input type="hidden" name="period" value="custom" />
                    <input type="date" name="startDate" class="form-control form-control-sm" value="@ViewBag.StartDate" required />
                    <span class="small text-muted">s/d</span>
                    <input type="date" name="endDate" class="form-control form-control-sm" value="@ViewBag.EndDate" required />
                    <button type="submit" class="btn btn-sm btn-dark"><i class="fa fa-search me-1"></i>Terapkan</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Real Stats Row -->
<div class="row">
    <div class="col-sm-6 col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="mb-2">Total Operasi</h4>
                        <div class="d-flex align-items-center">
                            <h2 class="mb-0">@Model.TotalOperasi</h2>
                        </div>
                    </div>
                    <div class="bg-primary-subtle rounded-circle p-3">
                        <i class="fa fa-hospital-o display-6 text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="mb-2">Operasi Bulan Ini</h4>
                        <div class="d-flex align-items-center">
                            <h2 class="mb-0">@Model.OperasiBulanIni</h2>
                        </div>
                        <small class="text-muted">@DateTime.Now.ToString("MMMM yyyy")</small>
                    </div>
                    <div class="bg-success-subtle rounded-circle p-3">
                        <i class="fa fa-calendar-check-o display-6 text-success"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="mb-2">Total Pasien</h4>
                        <div class="d-flex align-items-center">
                            <h2 class="mb-0">@Model.TotalPasien</h2>
                        </div>
                    </div>
                    <div class="bg-info-subtle rounded-circle p-3">
                        <i class="fa fa-users display-6 text-info"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row (Template Content) -->
<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between">
                <div class="header-title">
                    <h4 class="card-title">Top 5 Tindakan</h4>
                </div>
            </div>
            <div class="card-body pt-0">
                <div id="top-actions-chart"></div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="rounded d-flex align-items-center justify-content-center pb-4 pt-1">
                <img src="~/assets/images/page-img/39.png" class="img-fluid rounded" alt="banner-img">
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between">
                <div class="header-title">
                    <h4 class="card-title">Total Pasien per Rumah Sakit</h4>
                </div>
            </div>
            <div class="card-body pt-0">
                <div id="hospital-stats-chart" style="height: 415px;"></div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between">
                <div class="header-title">
                    <h4 class="card-title">Total Pasien per Jenis Kelamin</h4>
                </div>
            </div>
            <div class="card-body pt-0">
                <div id="gender-stats-chart"></div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Operations (Dynamic) & Reports (Static) -->
<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="border-bottom p-4 d-flex justify-content-between iq-recent-activity">
                <div class="header-title">
                    <h4 class="card-title">Recent Operations</h4>
                </div>
                <div class="card-header-toolbar d-flex align-items-center">
                    <a asp-controller="LaporanOperasi" asp-action="Index" class="btn btn-primary-subtle">View All</a>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table mb-0 table-borderless">
                        <thead>
                            <tr>
                                <th scope="col">Code</th>
                                <th scope="col">Date</th>
                                <th scope="col">Patient</th>
                                <th scope="col">Tindakan</th>
                                <th scope="col">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.RecentOperasi)
                            {
                                <tr>
                                    <td>@item.Code</td>
                                    <td>@item.Tanggal.ToString("dd MMM yyyy")</td>
                                    <td>@item.Pasien?.Nama</td>
                                    <td>@item.Tindakan?.Nama</td>
                                    <td>
                                        <a asp-controller="LaporanOperasi" asp-action="Edit" asp-route-id="@item.Id" class="text-primary"><i class="fa fa-pencil me-1"></i>Edit</a>
                                    </td>
                                </tr>
                            }
                            @if (!Model.RecentOperasi.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted">No recent operations found.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-header d-flex justify-content-between bg-warning-subtle text-dark">
                <div class="header-title">
                    <h5 class="card-title mb-0 text-dark"><i class="fa fa-clock-o me-2"></i>Follow-up Data Pasca Operasi</h5>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="py-2">Pasien</th>
                                <th class="py-2">Tgl Operasi</th>
                                <th class="py-2 text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.FollowUpOperasi.Any())
                            {
                                foreach (var item in Model.FollowUpOperasi)
                                {
                                    <tr>
                                        <td>
                                            <strong>@item.Pasien?.Nama</strong>
                                        </td>
                                        <td>
                                            <small class="text-muted">@item.Tanggal.ToString("dd/MM/yyyy")</small>
                                        </td>
                                        <td class="text-center">
                                            <a asp-controller="LaporanOperasi" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                                Update GOS
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-muted small">
                                        <em>Semua data sudah memiliki nilai GOS atau diluar periode follow-up.</em>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            @if (Model.FollowUpOperasi.Count >= 10)
            {
                <div class="card-footer text-center py-2 bg-light small">
                    <span class="text-muted">Menampilkan 10 data terbaru yang butuh follow-up.</span>
                </div>
            }
        </div>
    </div>

</div>

@section Scripts {
    <!-- Dashboard Specific Scripts -->
    <script src="~/assets/js/dashboard/dashboard-25438.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (document.querySelector("#top-actions-chart")) {
                var topActions = @Html.Raw(Json.Serialize(Model.TopActions));
                
                var options = {
                    series: [{
                        name: 'Count',
                        data: topActions.map(x => x.count)
                    }],
                    chart: {
                        type: 'bar',
                        height: 350
                    },
                    colors: ['#089bab'],
                    plotOptions: {
                        bar: {
                            borderRadius: 4,
                            horizontal: true,
                        }
                    },
                    dataLabels: {
                        enabled: true
                    },
                    xaxis: {
                        categories: topActions.map(x => x.actionName),
                    }
                };

                var chart = new ApexCharts(document.querySelector("#top-actions-chart"), options);
                chart.render();
            }

            if (document.querySelector("#hospital-stats-chart")) {
                var hospitalStats = @Html.Raw(Json.Serialize(Model.HospitalStats));
                
                var options = {
                    series: hospitalStats.map(x => x.count),
                    chart: {
                        type: 'donut',
                        height: 350
                    },
                    labels: hospitalStats.map(x => x.hospitalName),
                    colors: ['#089bab', '#FC9F5B', '#5bc5d1', '#ffd400', '#f16c20'],
                    plotOptions: {
                        pie: {
                            donut: {
                                size: '65%'
                            }
                        }
                    },
                    legend: {
                        position: 'bottom'
                    }
                };

                var chart = new ApexCharts(document.querySelector("#hospital-stats-chart"), options);
                chart.render();
            }

            if (document.querySelector("#gender-stats-chart")) {
                var genderStats = @Html.Raw(Json.Serialize(Model.GenderStats));
                
                var options = {
                    series: genderStats.map(x => x.count),
                    chart: {
                        type: 'pie',
                        height: 350
                    },
                    labels: genderStats.map(x => x.gender || "Unknown"),
                    colors: ['#089bab', '#FC9F5B', '#5bc5d1', '#ffd400'],
                    legend: {
                        position: 'bottom'
                    }
                };

                var chart = new ApexCharts(document.querySelector("#gender-stats-chart"), options);
                chart.render();
            }
        });
    </script>
}
