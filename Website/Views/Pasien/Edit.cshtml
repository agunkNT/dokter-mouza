@model DokterAbdurrahman.Models.Pasien

@{
    ViewData["Title"] = "Edit Pasien";
}

<h1>Edit Pasien</h1>

<h4>Pasien</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group mb-3">
                <label asp-for="Nama" class="control-label"></label>
                <input asp-for="Nama" class="form-control" />
                <span asp-validation-for="Nama" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="NoRM" class="control-label"></label>
                <input asp-for="NoRM" class="form-control" />
                <span asp-validation-for="NoRM" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="JenisKelamin" class="control-label">Jenis Kelamin</label>
                <select asp-for="JenisKelamin" class="form-control">
                    <option value="">-- Select --</option>
                    <option value="L">Laki-Laki</option>
                    <option value="P">Perempuan</option>
                </select>
                <span asp-validation-for="JenisKelamin" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Alamat" class="control-label"></label>
                <input asp-for="Alamat" class="form-control" />
                <span asp-validation-for="Alamat" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="TanggalLahir" class="control-label"></label>
                <input asp-for="TanggalLahir" class="form-control" type="date" />
                <span asp-validation-for="TanggalLahir" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
