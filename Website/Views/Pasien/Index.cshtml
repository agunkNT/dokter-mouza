@model IEnumerable<DokterAbdurrahman.Models.Pasien>

@{
    ViewData["Title"] = "Master Pasien";
}

<h1>Master Pasien</h1>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover" id="table-pasien">
        <thead>
            <tr>
                <th>Nama</th>
                <th>No RM</th>
                <th>L/P</th>
                <th>Usia</th>
                <th>Tgl Lahir</th>
                <th>Alamat</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model) {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Nama)</td>
                <td>@Html.DisplayFor(modelItem => item.NoRM)</td>
                <td>@Html.DisplayFor(modelItem => item.JenisKelamin)</td>
                <td>@Html.DisplayFor(modelItem => item.Usia)</td>
                <td>@item.TanggalLahir?.ToString("dd/MM/yyyy")</td>
                <td>@Html.DisplayFor(modelItem => item.Alamat)</td>
                <td>
                    <div class="d-flex">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-2">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </div>
                </td>
            </tr>
    }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#table-pasien').DataTable({
                "scrollX": true,
                "autoWidth": false
            });
        });
    </script>
}
