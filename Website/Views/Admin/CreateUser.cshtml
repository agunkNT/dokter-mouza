@model DokterAbdurrahman.Models.Admin

@{
    ViewData["Title"] = "Add New User";
}

<div class="row d-flex justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between">
                <div class="header-title">
                    <h4 class="card-title">Add New Administrator</h4>
                </div>
                <div class="card-header-toolbar d-flex align-items-center">
                    <a asp-action="Users" class="btn btn-primary-subtle">Back to List</a>
                </div>
            </div>
            <div class="card-body">
                <form asp-action="CreateUser" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group mb-3">
                        <label asp-for="Username" class="form-label font-weight-bold">Username</label>
                        <input asp-for="Username" class="form-control" placeholder="Enter Username" required />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Password" class="form-label font-weight-bold">Password</label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="Enter Password" required />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Role" class="form-label font-weight-bold">Role</label>
                        <select asp-for="Role" id="RoleSelect" class="form-control" asp-items="Html.GetEnumSelectList<UserRole>()" required>
                        </select>
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3" id="DokterGroup">
                        <label asp-for="DokterId" class="form-label font-weight-bold">Tautkan ke Dokter</label>
                        <select asp-for="DokterId" class="form-control" id="DokterSelect" 
                                asp-items="@(new SelectList(ViewBag.DokterList, "Id", "Nama"))">
                            <option value="">-- Pilih Dokter --</option>
                        </select>
                        <small class="text-muted">Pilih dokter yang akan dihubungkan dengan akun ini (Khusus Role: User).</small>
                        <span asp-validation-for="DokterId" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-end mt-4">
                        <button type="submit" class="btn btn-primary">Create User</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            function toggleDokterSelection() {
                var selectedRole = $('#RoleSelect').val();
                if (selectedRole == "0") { // Administrator
                    $('#DokterSelect').val('').prop('disabled', true);
                    $('#DokterGroup').fadeOut();
                } else { // User
                    $('#DokterSelect').prop('disabled', false);
                    $('#DokterGroup').fadeIn();
                }
            }

            $('#RoleSelect').change(toggleDokterSelection);
            toggleDokterSelection(); // Run on load
        });
    </script>
}
