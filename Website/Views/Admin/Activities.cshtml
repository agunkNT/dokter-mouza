@model DokterAbdurrahman.Models.LogViewModel

@{
    ViewData["Title"] = "User Activities";
}

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between">
                <div class="header-title">
                    <h4 class="card-title">User Activities Log</h4>
                </div>
                <div class="card-header-toolbar d-flex align-items-center">
                    <form asp-action="Activities" method="get" class="d-flex align-items-center">
                        <label class="me-2 mb-0">Select Date:</label>
                        <input type="date" name="date" class="form-control me-2" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
                    </form>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="activity-log-table" class="table table-striped table-bordered mt-4">
                        <thead>
                            <tr>
                                <th>Timestamp</th>
                                <th>Level</th>
                                <th>User</th>
                                <th>Action</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.Logs)
                            {
                                <tr class="@(log.Level == "ERROR" || log.Level == "FATAL" ? "table-danger" : (log.Level == "WARN" ? "table-warning" : ""))">
                                    <td>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>
                                        <span class="badge @(log.Level == "ERROR" || log.Level == "FATAL" ? "bg-danger" : (log.Level == "WARN" ? "bg-warning text-dark" : "bg-primary"))">
                                            @log.Level
                                        </span>
                                    </td>
                                    <td>
                                        <strong>@(string.IsNullOrEmpty(log.User) ? "-" : log.User)</strong>
                                    </td>
                                    <td>@log.Action</td>
                                    <td>
                                        <small class="text-muted d-block">@log.Message</small>
                                        @if (!string.IsNullOrEmpty(log.Url))
                                        {
                                            <span class="font-size-10 text-primary">URL: @log.Url</span>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!Model.Logs.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4">No logs found for the selected date.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#activity-log-table').DataTable({
                "order": [[0, "desc"]],
                "pageLength": 25
            });
        });
    </script>
}
