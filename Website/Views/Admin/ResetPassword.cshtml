@model DokterAbdurrahman.Models.Admin

@{
    ViewData["Title"] = "Reset Password";
}

<div class="row d-flex justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between">
                <div class="header-title">
                    <h4 class="card-title">Reset Password for: @Model.Username</h4>
                </div>
                <div class="card-header-toolbar d-flex align-items-center">
                    <a asp-action="Users" class="btn btn-primary-subtle">Back to List</a>
                </div>
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    <i class="fa fa-info-circle me-2"></i>
                    Administrator can reset the password for this user without knowing the old password.
                </div>
                <form asp-action="ResetPassword" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="form-group mb-3">
                        <label class="form-label font-weight-bold">New Password</label>
                        <input name="newPassword" type="password" class="form-control" placeholder="Enter New Password" required />
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        <button type="submit" class="btn btn-primary">Update Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
