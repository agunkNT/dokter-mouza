@model IEnumerable<DokterAbdurrahman.Models.Admin>

@{
    ViewData["Title"] = "User Management";
}

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between">
                <div class="header-title">
                    <h4 class="card-title">User Management</h4>
                </div>
                <div class="card-header-toolbar d-flex align-items-center">
                    <a asp-action="CreateUser" class="btn btn-primary">Add New User</a>
                </div>
            </div>
            <div class="card-body">
                @if (TempData["Message"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Message"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                <div class="table-responsive">
                    <table id="user-list-table" class="table table-striped table-bordered mt-4" role="grid" aria-describedby="user-list-page-info">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Username</th>
                                <th>Role</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.Id</td>
                                    <td>@user.Username</td>
                                    <td>
                                        <span class="badge @(user.Role == DokterAbdurrahman.Models.UserRole.Administrator ? "bg-primary" : "bg-info")">
                                            @user.Role
                                        </span>
                                    </td>
                                    <td>
                                        <div class="flex align-items-center list-user-action">
                                            <a asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-sm btn-info-subtle me-1" data-bs-toggle="tooltip" data-bs-placement="top" title="Reset Password">
                                                <i class="fa fa-key"></i>
                                            </a>
                                            <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this user?');" style="display:inline;">
                                                <button type="submit" class="btn btn-sm btn-danger-subtle" data-bs-toggle="tooltip" data-bs-placement="top" title="Delete">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#user-list-table').DataTable();
        });
    </script>
}
