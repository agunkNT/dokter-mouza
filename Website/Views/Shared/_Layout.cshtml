@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isLoginPage = string.Equals(currentController, "Account", StringComparison.OrdinalIgnoreCase) && 
                      string.Equals(currentAction, "Login", StringComparison.OrdinalIgnoreCase);
    
    var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
    var isAdministrator = string.Equals(userRole, "Administrator", StringComparison.OrdinalIgnoreCase);
}
<!doctype html>
<html lang="en" class="theme-fs-sm" data-bs-theme="light" data-bs-theme-color="default" dir="ltr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>M.A.N - @ViewData["Title"]</title>
    
    <meta name="setting_options" content='{&quot;saveLocal&quot;:&quot;sessionStorage&quot;,&quot;storeKey&quot;:&quot;XRay&quot;,&quot;setting&quot;:{&quot;app_name&quot;:{&quot;value&quot;:&quot;XRay&quot;},&quot;theme_scheme_direction&quot;:{&quot;value&quot;:&quot;ltr&quot;},&quot;theme_scheme&quot;:{&quot;value&quot;:&quot;light&quot;},&quot;theme_style_appearance&quot;:{&quot;value&quot;:[&quot;theme-default&quot;]},&quot;theme_color&quot;:{&quot;value&quot;:&quot;default&quot;},&quot;theme_transition&quot;:{&quot;value&quot;:&quot;theme-with-animation&quot;},&quot;theme_font_size&quot;:{&quot;value&quot;:&quot;theme-fs-sm&quot;},&quot;page_layout&quot;:{&quot;value&quot;:&quot;container-fluid&quot;},&quot;header_navbar&quot;:{&quot;value&quot;:&quot;default&quot;},&quot;header_banner&quot;:{&quot;value&quot;:&quot;default&quot;},&quot;sidebar_color&quot;:{&quot;value&quot;:&quot;sidebar-color&quot;},&quot;card_color&quot;:{&quot;value&quot;:&quot;card-default&quot;},&quot;sidebar_type&quot;:{&quot;value&quot;:[&quot;sidebar-hover&quot;,&quot;sidebar-mini&quot;]},&quot;sidebar_menu_style&quot;:{&quot;value&quot;:&quot;sidebar-default navs-pill-all&quot;},&quot;footer&quot;:{&quot;value&quot;:&quot;default&quot;},&quot;body_font_family&quot;:{&quot;value&quot;:null},&quot;heading_font_family&quot;:{&quot;value&quot;:null}}}'>
    
    <!-- Config Options -->
    <script>
        (function () {
            const savedTheme = sessionStorage.getItem('XRay');

            if (savedTheme) {
                const settings = JSON.parse(savedTheme);
                const themeScheme = settings.setting.theme_scheme.value;
                document.documentElement.setAttribute('data-bs-theme', themeScheme);
            }
        })();
    </script>

    <!-- Library / Plugin Css Build -->
    <link rel="stylesheet" href="~/assets/css/core/libs.min.css" />
    
    <!-- flaticon css -->
    <link rel="stylesheet" href="~/assets/vendor/flaticon/css/flaticon.css" />
    
    <!-- font-awesome css -->
    <link rel="stylesheet" href="~/assets/vendor/font-awesome/css/font-awesome.min.css" />
    
    <!-- Flatpickr css -->
    <link rel="stylesheet" href="~/assets/vendor/flatpickr/dist/flatpickr.min.css" />
    
    <!-- Xray Design System Css -->
    <link rel="stylesheet" href="~/assets/css/xray.min.css?v=1.2.0" />
    
    <!-- Custom Css -->
    <link rel="stylesheet" href="~/assets/css/custom.min.css?v=1.2.0" />

    <!-- RTL Css -->
    <link rel="stylesheet" href="~/assets/css/rtl.min.css?v=1.2.0" />
    
    <!-- Customizer Css -->
    <link rel="stylesheet" href="~/assets/css/customizer.min.css?v=1.2.0" />
    
    <!-- Remixicon -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css" rel="stylesheet">
    
    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com/">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
    <link href="https://fonts.googleapis.com/css?family=Poppins:200,200i,300,400,500,600,700,800,900&amp;display=swap" rel="stylesheet">
    
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.0/css/dataTables.bootstrap5.css" />
</head>

<body class="">
    <!-- loader Start -->
    <div id="loading">
        <div class="loader simple-loader">
            <div class="loader-body">
                <img src="~/assets/images/loader.gif" alt="loader" class="light-loader img-fluid " width="200">
            </div>
        </div>
    </div>
    <!-- loader END -->
    
    <div class="wrapper">
        @if (!isLoginPage)
        {
            <aside class="sidebar sidebar-base sidebartab1" id="first-tour" data-toggle="main-sidebar" data-sidebar="responsive">
                <div class="sidebar-header d-flex align-items-center justify-content-start position-relative">
                     <a asp-controller="Home" asp-action="Index" class="navbar-brand me-5 pt-3">
                        <div class="logo-main">
                            <img class="logo-normal img-fluid mb-3" src="~/assets/images/logo.png" height="30" alt="logo">
                            <span class="ms-2 brand-name"> M.A.N</span>
                        </div>
                    </a>
                    @* <div class="ms-5 wrapper-menu d-flex d-none d-xl-block">
                        <div class="main-circle" role="button"><i class="ri-more-fill"></i></div>
                    </div>
                    <li class="nav-item d-block d-xl-none">
                        <a class="wrapper-menu" data-toggle="sidebar" data-active="true">
                            <div class="main-circle "><i class="ri-more-fill"></i></div>
                        </a>
                    </li> *@
                </div>

                <div class="sidebar-body pt-0 data-scrollbar">
                    <div class="sidebar-list">
                        <!-- Sidebar Menu Start -->
                        <ul class="navbar-nav iq-main-menu" id="sidebar-menu">
                            <li>
                                <hr class="hr-horizontal">
                            </li>
                            <li class="nav-item static-item ms-2">
                                <a class="nav-link static-item disabled text-start" href="#" tabindex="-1">
                                    <span class="default-icon">Main Menu</span>
                                    <span class="mini-icon">-</span>
                                </a>
                            </li>
                            
                            <li class="nav-item">
                                    <a class="nav-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                    <i class="fa fa-home" data-bs-toggle="tooltip" title="Dashboard" data-bs-placement="right"></i>
                                    <span class="item-name">Dashboard</span>
                                </a>
                            </li>
                            
                            <li class="nav-item">
                                <a class="nav-link @(currentAction == "KonsultasiPre" ? "active" : "")" asp-controller="Pemeriksaan" asp-action="KonsultasiPre">
                                    <i class="fa fa-comments-o" data-bs-toggle="tooltip" title="Konsultasi Pre-Op" data-bs-placement="right"></i>
                                    <span class="item-name">Konsultasi Pre-Op</span>
                                </a>
                            </li>
                            
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "LaporanOperasi" ? "active" : "")" asp-controller="LaporanOperasi" asp-action="Index">
                                    <i class="fa fa-list-alt" data-bs-toggle="tooltip" title="Laporan Operasi" data-bs-placement="right"></i>
                                    <span class="item-name">Laporan Operasi</span>
                                </a>
                            </li>

                             <li class="nav-item">
                                <a class="nav-link @(currentAction == "ControlPost" ? "active" : "")" asp-controller="Pemeriksaan" asp-action="ControlPost">
                                    <i class="fa fa-stethoscope" data-bs-toggle="tooltip" title="Kontrol Post-Op" data-bs-placement="right"></i>
                                    <span class="item-name">Kontrol Post-Op</span>
                                </a>
                            </li>
                            
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Report" ? "active" : "")" asp-controller="Report" asp-action="Index">
                                    <i class="fa fa-bar-chart" data-bs-toggle="tooltip" title="Reports" data-bs-placement="right"></i>
                                    <span class="item-name">Reports</span>
                                </a>
                            </li>

                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                @if (isAdministrator)
                                {
                                    <li class="nav-item">
                                        <div class="colors">
                                            <a class="nav-link" data-bs-toggle="collapse" href="#masterData" role="button" aria-expanded="false">
                                                <i class="fa fa-database" data-bs-toggle="tooltip" title="Master Data" data-bs-placement="right"></i>
                                                <span class="item-name">Master Data</span>
                                                <i class="right-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" class="icon-18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                                    </svg>
                                                </i>
                                            </a>
                                            <ul class="sub-nav collapse" id="masterData" data-bs-parent="#sidebar-menu">
                                                <li class="">
                                                    <a class="nav-link @(currentController == "Pasien" ? "active" : "")" asp-controller="Pasien" asp-action="Index">
                                                        <i class="fa fa-user"></i>
                                                        <span class="item-name">Pasien</span>
                                                    </a>
                                                </li>
                                                <li class="">
                                                    <a class="nav-link @(currentController == "Dokter" ? "active" : "")" asp-controller="Dokter" asp-action="Index">
                                                        <i class="fa fa-user-md"></i>
                                                        <span class="item-name">Dokter</span>
                                                    </a>
                                                </li>
                                                <li class="">
                                                    <a class="nav-link @(currentController == "RumahSakit" ? "active" : "")" asp-controller="RumahSakit" asp-action="Index">
                                                        <i class="fa fa-building"></i>
                                                        <span class="item-name">Rumah Sakit</span>
                                                    </a>
                                                </li>
                                                <li class="">
                                                    <a class="nav-link @(currentController == "Diagnosa" ? "active" : "")" asp-controller="Diagnosa" asp-action="Index">
                                                        <i class="fa fa-stethoscope"></i>
                                                        <span class="item-name">Diagnosa</span>
                                                    </a>
                                                </li>
                                                <li class="">
                                                    <a class="nav-link @(currentController == "Tindakan" ? "active" : "")" asp-controller="Tindakan" asp-action="Index">
                                                        <i class="fa fa-medkit"></i>
                                                        <span class="item-name">Tindakan</span>
                                                    </a>
                                                </li>
                                                <li class="">
                                                    <a class="nav-link @(currentController == "JenisTindakan" ? "active" : "")" asp-controller="JenisTindakan" asp-action="Index">
                                                        <i class="fa fa-list-ul"></i>
                                                        <span class="item-name">Jenis Tindakan</span>
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </li>
                                }
                                
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "Drive" ? "active" : "")" asp-controller="Drive" asp-action="Index">
                                        <i class="fa fa-google" data-bs-toggle="tooltip" title="Google Drive" data-bs-placement="right"></i>
                                        <span class="item-name">Google Drive</span>
                                    </a>
                                </li>
                                
                                @if (isAdministrator)
                                {
                                    <li class="nav-item">
                                        <div class="colors">
                                            <a class="nav-link" data-bs-toggle="collapse" href="#adminPanel" role="button" aria-expanded="false">
                                                <i class="fa fa-cogs" data-bs-toggle="tooltip" title="Admin Panel" data-bs-placement="right"></i>
                                                <span class="item-name">Admin Panel</span>
                                                <i class="right-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" class="icon-18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                                    </svg>
                                                </i>
                                            </a>
                                            <ul class="sub-nav collapse" id="adminPanel" data-bs-parent="#sidebar-menu">
                                                <li class="">
                                                    <a class="nav-link @(currentController == "Admin" && currentAction == "Users" ? "active" : "")" asp-controller="Admin" asp-action="Users">
                                                        <i class="fa fa-users"></i>
                                                        <span class="item-name">User Management</span>
                                                    </a>
                                                </li>
                                                <li class="">
                                                    <a class="nav-link @(currentController == "Admin" && currentAction == "Activities" ? "active" : "")" asp-controller="Admin" asp-action="Activities">
                                                        <i class="fa fa-history"></i>
                                                        <span class="item-name">User Activities</span>
                                                    </a>
                                                </li>
                                                <li class="">
                                                    <a class="nav-link @(currentController == "Log" ? "active" : "")" asp-controller="Log" asp-action="Index">
                                                        <i class="fa fa-file-text"></i>
                                                        <span class="item-name">System Logs (Dev)</span>
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </li>
                                }

                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Account" asp-action="Login">
                                        <i class="fa fa-sign-in" data-bs-toggle="tooltip" title="Login" data-bs-placement="right"></i>
                                        <span class="item-name">Admin Login</span>
                                    </a>
                                </li>
                            }
                        </ul>
                        <!-- Sidebar Menu End -->
                    </div>
                </div>
                <div class="sidebar-footer"></div>
            </aside>

        }
        
        <main class="main-content @(isLoginPage ? "" : "content-page")">
            @if (!isLoginPage)
            {
                <div class="position-relative">
                    <!--Nav Start-->
                    <nav class="nav navbar navbar-expand-xl navbar-light iq-navbar pt-2 pb-2 px-2" id="boxid">
                        <div class="container-fluid navbar-inner">
                            <div class="row flex-grow-1">
                                <div class="col-lg-4 col-md-6 align-items-center d-flex">
                                    @* <li class="nav-item dropdown search-width pt-2 pt-lg-0">
                                        <div class="form-group input-group mb-0 search-input">
                                            <input type="text" class="form-control" placeholder="Type here to search...">
                                            <span class="input-group-text">
                                                <svg class="icon-20 text-primary" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                    <circle cx="11.7669" cy="11.7666" r="8.98856" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></circle>
                                                    <path d="M18.0186 18.4851L21.5426 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                                                </svg>
                                            </span>
                                        </div>
                                    </li> *@
                                </div>
                                <div class="col-lg-8 col-md-6 d-flex justify-content-end align-items-center">
                                    <li class="nav-item iq-full-screen d-none d-xl-block" id="fullscreen-item">
                                        <a href="#" class="nav-link" id="btnFullscreen">
                                            <i class="fa fa-arrows-alt normal-screen"></i>
                                            <i class="fa fa-compress full-normal-screen d-none"></i>
                                        </a>
                                    </li>
                                    
                                     <li class="nav-item d-block d-xl-none">
                                       <a class="wrapper-menu" data-toggle="sidebar" data-active="true">
                                          <div class="main-circle "><i class="fa fa-ellipsis-h"></i></div>
                                       </a>
                                    </li>
                                    <li class=" nav-item ms-3 d-flex align-items-center d-block d-xl-none">
                                       <button id="navbar-toggle" class="navbar-toggler px-0" type="button" data-bs-toggle="collapse"
                                          data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false"
                                          aria-label="Toggle navigation">
                                          <span class="navbar-toggler-btn">
                                             <span class="navbar-toggler-icon"></span>
                                          </span>
                                       </button>
                                    </li>

                                    <li class="nav-item dropdown">
                                        <a href="#" class="nav-link d-flex align-items-center" id="notification-drop" data-bs-toggle="dropdown">
                                            <div class="caption d-none d-lg-block">
                                                @if (User.Identity != null && User.Identity.IsAuthenticated)
                                                {
                                                     <h6 class="mb-0 line-height">@User.Identity.Name</h6>
                                                     <span class="font-size-12">@userRole</span>
                                                }
                                                else
                                                {
                                                     <h6 class="mb-0 line-height">Guest</h6>
                                                }
                                            </div>
                                        </a>
                                        <div class="p-0 sub-drop dropdown-menu dropdown-menu-end" aria-labelledby="notification-drop">
                                            <div class="m-0 -none card">
                                                <div class="p-0 card-body">
                                                    @if (User.Identity != null && User.Identity.IsAuthenticated) {
                                                        <a asp-controller="Account" asp-action="ChangePassword" class="iq-sub-card iq-bg-primary-hover">
                                                            <div class="media align-items-center">
                                                                @* <div class="rounded iq-card-icon iq-bg-primary">
                                                                    <i class="ri-lock-password-line"></i>
                                                                </div> *@
                                                                <div class="media-body ms-3">
                                                                    <h6 class="mb-0"><i class="fa fa-lock"></i> Change Password</h6>
                                                                    <p class="mb-0 font-size-12">Update your security settings.</p>
                                                                </div>
                                                            </div>
                                                        </a>
                                                        <div class="d-inline-block w-100 text-center p-3">
                                                            <a asp-controller="Account" asp-action="Logout" class="btn btn-primary iq-sign-btn" role="button">
                                                                Sign out
                                                                <i class="fa fa-sign-out ms-2"></i>
                                                            </a>
                                                        </div>
                                                    } else {
                                                         <div class="iq-sub-card d-flex justify-content-center">
                                                            <a asp-controller="Account" asp-action="Login" class="btn btn-primary-subtle">
                                                                Sign In
                                                                <i class="fa fa-sign-in ms-2"></i>
                                                            </a>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </li>
                                </div>
                            </div>
                        </div>
                    </nav>
                    <!--Nav End-->
                </div>
            }

            <div class="content-inner container-fluid pb-0" id="page_layout">
                 @RenderBody()
            </div>

            <!-- Footer Section Start -->
            <footer class="footer rounded-pill mb-4 mx-0 mx-md-4">
                <div class="footer-body">
                    <div class="row d-flex flex-grow-1">
                        <div class="col-lg-6 col-md-12">
                            <ul class="left-panel list-inline mb-0 p-0 d-flex justify-content-center justify-content-lg-start">
                                <li class="list-inline-item fw-500"><a class="footer-link" href="#">Privacy Policy</a></li>
                                <li class="list-inline-item fw-500"><a class="footer-link footer-spacing" href="#">Terms of Use</a></li>
                            </ul>
                        </div>
                        <div class="col-lg-6 col-md-12">
                            <h6 class="right-panel mb-0 d-flex justify-content-center justify-content-lg-end">
                                Copyright <script>document.write(new Date().getFullYear())</script> <a href="#" class="px-1">MAN</a> All Rights Reserved.
                            </h6>
                        </div>
                    </div>
                </div>
            </footer>
            <!-- Footer Section End -->
        </main>
    </div>

    <!-- Library Bundle Script -->
    <script src="~/assets/js/core/libs.min.js"></script>
    
    <!-- External Library Bundle Script -->
    <script src="~/assets/js/core/external.min.js"></script>
    
    <!-- Lodash Utility -->
    <script src="~/assets/vendor/lodash/lodash.min.js"></script>
    
    <!-- Utilities Functions -->
    <script src="~/assets/js/iqonic-script/utility.min.js"></script>
    
    <!-- Settings Script -->
    <script src="~/assets/js/iqonic-script/setting.min.js"></script>
    
    <!-- Settings Init Script -->
    <script src="~/assets/js/iqonic-script/setting-init.js"></script>

    <!-- fslightbox Script -->
    <script src="~/assets/js/plugins/fslightbox.js"></script>
    

    
    <!-- App Script -->
    <script src="~/assets/js/xray5438.js?v=1.2.0" defer></script>
    <script src="~/assets/js/xray-advance5438.js?v=1.2.0" defer></script>
    <script src="~/assets/js/sidebar5438.js?v=1.2.0" defer></script>

    <!-- Fallback to hide loader -->
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            setTimeout(function() {
                var loader = document.getElementById('loading');
                if(loader && window.getComputedStyle(loader).display !== 'none') {
                    loader.style.display = 'none';
                    console.warn('Loader hidden by fallback script.');
                }
            }, 2000);
        });
    </script>

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/2.0.0/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.0/js/dataTables.bootstrap5.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
